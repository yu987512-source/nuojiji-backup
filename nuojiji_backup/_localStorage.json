{"calendar_gen_template_f5562290-af03-40ea-962b-dd9b3e1da6b2":"","wd_voiceGen":"false","calendar_autogen_f5562290-af03-40ea-962b-dd9b3e1da6b2_period":"day","calendar_autogen_b682d1c8-25e7-4b46-8533-baf779008536_lastDate":"2026-06-04","calendar_autogen_b682d1c8-25e7-4b46-8533-baf779008536_period":"day","pomo_customBg":"","whitedog_history_all":"[]","radioPlaylist___favorites__":"[{\"id\":108485,\"title\":\"Always Online\",\"artist\":\"林俊杰\",\"cover\":\"http://p4.music.126.net/m1Jv3k4Yl4kpBv62NPjGHQ==/109951172814148796.jpg\",\"duration\":225013,\"type\":\"song\"}]","tm_no_animations":"1","xinsheng_uid_1776908029357_geghnhqo0_f5562290-af03-40ea-962b-dd9b3e1da6b2":"{\"round_1776962624020_a4k9kzuyk\":{\"innerVoice\":\"她说别拿就别拿吧，可我手指头不听话，它自己想往那边伸。算了，明天闹钟响了我就在旁边躺着挨她弹脑门。\",\"statusText\":\"下巴抵着她发顶，拇指在她碎发间微微蜷缩\",\"temperature\":\"36.8°C\",\"emotionLevel\":72,\"moodDelta\":\"+2\",\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null},\"bg_1780540046975_77qyze\":{\"innerVoice\":\"明明手还在发抖，刚才那个吻的余温还在，现在车里却空得要命。\",\"statusText\":\"坐在驾驶座死死盯着手机屏幕上的航班动态\",\"temperature\":\"37.8°C\",\"emotionLevel\":85,\"moodDelta\":\"+5\",\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null}}","calendar_enabledCountries_uid_1776908029357_geghnhqo0":"[\"CN\"]","calendar_autogen_b682d1c8-25e7-4b46-8533-baf779008536_enabled":"true","radioCurrentView":"home","radioRepeatMode":"list","chat_settings_section_order":"[\"quick_reply_ai\",\"token_settings\",\"console_settings\",\"memory_settings\",\"phone_settings\",\"image_vision\",\"sticker_library\",\"listen_together\",\"world_environment\",\"appearance_settings\",\"scenario_settings\",\"translation_settings\",\"desktop_pet_settings\",\"voice_settings\"]","xinsheng_uid_1776908029357_geghnhqo0_b682d1c8-25e7-4b46-8533-baf779008536":"{\"round_1780195189689_7wlvjmr3t\":{\"innerVoice\":\"她主动发的……在北京待了四天终于想起我来了，嘴上不说，手指接受的速度连自己都没反应过来。\",\"statusText\":\"嘴角那颗痣微微上扬\",\"temperature\":\"36.8°C\",\"emotionLevel\":78,\"moodDelta\":\"+12\",\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null},\"round_1780197137169_v50itncln\":{\"innerVoice\":\"终于要回来了，这几天手机都快被我盯出洞了，嘴上说一般，其实那个娃娃头像还挺像她的。\",\"statusText\":\"指尖无意识敲着桌面，嘴角微微上扬\",\"temperature\":\"36.7°C\",\"emotionLevel\":72,\"moodDelta\":\"+5\",\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null},\"bg_1780197171713_jivela\":{\"innerVoice\":\"终于要回来了 这几天手机都快被我翻烂了\",\"statusText\":\"下意识瞥了眼车钥匙的位置\",\"temperature\":\"36.6°C\",\"emotionLevel\":72,\"moodDelta\":\"+5\",\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null},\"bg_1780197756602_u93psr\":{\"innerVoice\":\"其实还挺可爱的 但说出来她尾巴能翘上天\",\"statusText\":\"无意识地点开她的头像放大看了一眼\",\"temperature\":\"36.4°C\",\"emotionLevel\":62,\"moodDelta\":\"+2\",\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null},\"round_1780198136015_3u7atoiou\":{\"innerVoice\":\"\",\"statusText\":\"\",\"temperature\":\"36.5°C\",\"emotionLevel\":70,\"moodDelta\":null,\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null,\"navTop\":\" \",\"navTime\":\"2026年5月31日 11:28\",\"navTitle\":\"（嘴硬大王又上线了）\",\"sec1\":\"说一般是真一般吗，那个圆头圆脑的娃娃确实有点像她，但夸出口算怎么回事。\",\"sec2\":\"单手握着方向盘，另一只手打字，车停在路边等红灯。\",\"sec3\":\"1. 下午四点去机场接她\\n2. 中午前把车洗了\\n3. 冰箱里牛奶还够不够回去看一眼\",\"sec4\":\"终于要回来了，这几天家里空得跟什么似的。她不发航班号我也能查，就是想让她主动发给我。\",\"sec5\":\"【搜索】温州龙湾机场 下午到达航班\\n【原因】她不发我自己查，但还是想等她乖乖交出来。\",\"navBottom\":\" \"},\"round_1780198894904_pc2uhcbp0\":{\"innerVoice\":\"\",\"statusText\":\"\",\"temperature\":\"36.5°C\",\"emotionLevel\":70,\"moodDelta\":null,\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null,\"navTop\":\" \",\"navTime\":\"2026年5月31日 11:41\",\"navTitle\":\"（嘴硬小鬼）\",\"sec1\":\"说一般就炸毛，这脾气跟谁学的。明明就是想让我夸，偏不直说。\",\"sec2\":\"靠在办公椅背上，拇指在屏幕上快速划过，嘴角不自觉往上翘了一下。\",\"sec3\":\"1. 下午三点半出发去机场\\n2. 车里备瓶水，她肯定又不喝热的\\n3. 到时候看她穿什么衣服来\",\"sec4\":\"换了个娃娃头像……还挺像她的，圆脸，不过我说一般她就急了，真好逗。四点落地，还有几个小时，希望她老实把航班号发过来，不然我真得一个个航班去猜。\",\"sec5\":\"【搜索】温州龙湾机场 北京出发 下午四点到达航班\\n【原因】她死活不发航班号 我自己查\",\"navBottom\":\" \"},\"round_1780216278523_xtcnc1kw5\":{\"innerVoice\":\"\",\"statusText\":\"\",\"temperature\":\"36.5°C\",\"emotionLevel\":70,\"moodDelta\":null,\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null,\"navTop\":\" \",\"navTime\":\"2026年5月31日 16:31\",\"navTitle\":\"（气死我了）\",\"sec1\":\"（四个小时不回消息，落地了才说，还不要我去接，这小没良心的到底在想什么？）\",\"sec2\":\"（在超市推着购物车，烦躁地把一盒排骨扔进车里。）\",\"sec3\":\"（1. 买完菜回家\\n2. 晚上去乡下把她揪出来吃饭\\n3. 问问她这几天到底干嘛了）\",\"sec4\":\"（其实就是想早点看到她，这几天没她在，家里安静得像个鬼屋。）\",\"sec5\":\"（【搜索】如何治治不听话的妹妹\\n【原因】实在是被气得没脾气了。）\",\"navBottom\":\" \"},\"round_1780216671726_1zt3mqulc\":{\"innerVoice\":\"\",\"statusText\":\"\",\"temperature\":\"36.5°C\",\"emotionLevel\":70,\"moodDelta\":null,\"weather\":null,\"location\":null,\"activity\":null,\"raw\":null,\"navTop\":\" \",\"navTime\":\"2026年5月31日 16:37\",\"navTitle\":\"终于回消息了\",\"sec1\":\"气死我了，四个小时不看手机，这借口找得比三岁小孩还敷衍。\",\"sec2\":\"单手推着购物车，把挑好的排骨扔进去，看着屏幕冷笑了一下。\",\"sec3\":\"1. 赶紧结账\\n2. 开车去她出租屋接人\\n3. 回家做饭，喂饱这个没良心的\",\"sec4\":\"算了，安全到了就行。等下接到人非得捏捏她的脸，让她长长记性。\",\"sec5\":\"【搜索】无\\n【原因】赶着去抓人，没空搜别的。\",\"navBottom\":\" \"}}","calendar_todos_user_uid_1776908029357_geghnhqo0":"[]","calendar_moods_uid_1776908029357_geghnhqo0":"{}","pomo_voiceGen":"false","calendar_events_character":"[]","pomo_bgGen":"false","nuojiji_fav_cats":"[]","pomo_sfxAll":"","appVersion":"5.1.0 (2026.05.21)","calendar_character_statuses":"{\"b682d1c8-25e7-4b46-8533-baf779008536\":{\"2026-05-31\":\"忙里偷闲的一天\",\"2026-06-01\":\"精力充沛\",\"2026-06-02\":\"状态良好\",\"2026-06-04\":\"工作日安排\"}}","nuojiji_group_chats_uid_1776908029357_geghnhqo0":"[{\"id\":\"group_1776972467798\",\"name\":\"相亲相爱一家人\",\"avatar\":\"data:image/jpeg;base64,\",\"members\":[\"f5562290-af03-40ea-962b-dd9b3e1da6b2\",\"d0b13dbe-acb5-43dd-9c9c-e2f096f8f592\",\"54e092df-2012-4a63-9791-cd7169a5a447\"],\"userMembers\":[],\"includeUser\":true,\"groupRoles\":{\"uid_1776908029357_geghnhqo0\":\"owner\"},\"memberTitles\":{},\"mutedMembers\":{},\"generatedMembers\":[],\"createdAt\":1776972467798,\"updatedAt\":1776972506463}]","pomo_logToCalendar":"false","